{
  "mcpServers": {
    "parallel-search": {
      "url": "https://search.parallel.ai/mcp",
      "headers": {
        "Authorization": "!echo Bearer $(security find-generic-password -s parallel-search-api -a pi -w)"
      },
      "exposure": "deferred"
    },
    "aws-mcp": {
      "command": "~/.local/bin/uvx",
      "args": ["mcp-proxy-for-aws-cli@latest", "https://aws-mcp.us-east-1.api.aws/mcp"],
      "env": {
        "AWS_MCP_PROXY_PROFILES": "pc"
      },
      "timeout": 120,
      "description": "AWS MCP Server via the SigV4 proxy",
      "exposure": "deferred"
    }
  }
}
