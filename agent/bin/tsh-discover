#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# tsh-discover — read-only Teleport discovery across EVERY cluster profile in
# the shared Teleport client home.
#
# Why this exists (incident 2026-11-22, H4-BOARD.md ~L1989-1993): a bare
# 'tsh ls --proxy=teleport-admin.piercloud.net' lists ONLY that one cluster
# (pc-host-01) and makes the narrow view look authoritative. The pc-control
# machine lives in the SECOND cluster (teleport-control.piercloud.net:443);
# H4 (and the P3 lanes that inherited its conclusion) declared "no access to
# the pc-control machine" off a one-cluster listing.
#
# The cluster list is READ, never hard-coded: the shared home carries one
# profile yaml per proxy (~/.tsh/<proxy>.yaml), each with a 'cluster:' field.
# For each profile this prints a header + 'tsh status --proxy=<p>' (identity,
# valid until) + 'tsh ls --proxy=<p>' (nodes with their plane label). A
# cluster whose certificate expired or whose 'ls' fails prints
# 'NOT READABLE: <reason> — ask the owner for a login tap'; nothing is ever
# skipped silently.
#
# Read-only by construction: no tsh login/logout, no writes anywhere — in
# particular none under the Teleport client home. Every tsh call is bounded
# (timeout, default 60 s), reads </dev/null (an expired or missing cert
# otherwise drops into a passkey re-login prompt that hangs on a piped-in
# EOF), and never mutates current-profile (verified: 11 pinned runs left its
# sha256 + mtime unchanged — H4-BOARD.md '00:15Z tsh pin test b8824fa5').
#
# Usage: tsh-discover
#   TSD_TIMEOUT=30   per-call timeout in seconds (default 60)
#   TSH=/path/to/tsh  tsh binary (default: tsh on PATH)
#   TELEPORT_HOME=…  client home to inspect (default: ~/.tsh)
# Exit: 0 every cluster readable, 1 at least one NOT READABLE, 2 fatal.
set -uo pipefail

readonly PROG="tsh-discover"
tsh_bin="${TSH:-tsh}"
bound="${TSD_TIMEOUT:-60}"
home="${TELEPORT_HOME:-$HOME/.tsh}"

die() {
	printf '%s: %s\n' "$PROG" "$*" >&2
	exit 2
}

short() {
	local p="${1:-$HOME}"
	printf '%s' "${p/#$HOME/~}"
}

command -v "$tsh_bin" >/dev/null 2>&1 ||
	die "tsh not found (TSH=$tsh_bin); nothing can be discovered without a client"
[[ "$bound" =~ ^[0-9]+$ ]] && [ "$bound" -gt 0 ] ||
	die "TSD_TIMEOUT must be a positive integer (got '$bound')"
[ -d "$home" ] ||
	die "no Teleport client home at $(short "$home") — no cluster is logged in; ask the owner for a login tap"

shopt -s nullglob
profiles=("$home"/*.yaml)
[ "${#profiles[@]}" -gt 0 ] ||
	die "no proxy profile (*.yaml) in $(short "$home") — no cluster is logged in; ask the owner for a login tap"

printf '%s — every cluster profile in %s (%d profile(s)), read-only, %ss bound per call\n' \
	"$PROG" "$(short "$home")" "${#profiles[@]}" "$bound"

summary=""
unreadable=0

for profile in "${profiles[@]}"; do
	# The profile's own 'cluster:' field is the source of truth; the yaml
	# filename and the web_proxy_addr are fallbacks for older profiles.
	proxy="$(sed -n 's/^cluster:[[:space:]]*//p' "$profile" | head -n 1)"
	[ -n "$proxy" ] ||
		proxy="$(sed -n 's/^web_proxy_addr:[[:space:]]*//p' "$profile" | head -n 1)"
	[ -n "$proxy" ] || proxy="$(basename "$profile" .yaml)"
	host="${proxy%%:*}"

	printf '\n=== %s  (profile %s)\n' "$proxy" "$(short "$profile")"

	# ---- status: identity + valid until for THIS proxy ------------------
	printf -- '--- tsh status --proxy=%s\n' "$proxy"
	status_out="$(timeout "$bound" "$tsh_bin" status --proxy="$proxy" </dev/null 2>&1)"
	status_rc=$?
	# 'tsh status' prints one blank-line-separated block per profile; keep
	# the block for this cluster only.
	block="$(printf '%s\n' "$status_out" | awk -v host="$host" 'BEGIN { RS=""; ORS="\n\n" } index($0, "://" host ":") > 0 { print }')"
	if [ -z "$block" ]; then
		reason="no certificate for this cluster"
		[ "$status_rc" -eq 124 ] && reason="tsh status timed out after ${bound}s"
		[ "$status_rc" -eq 0 ] && reason="tsh status lists no profile for this cluster"
		[ "$status_rc" -ne 0 ] && [ "$status_rc" -ne 124 ] &&
			reason="tsh status failed (rc=$status_rc): $(printf '%s\n' "$status_out" | grep -v '^[[:space:]]*$' | head -n 1)"
		printf '  NOT READABLE: %s — ask the owner for a login tap\n' "$reason"
		unreadable=$((unreadable + 1))
	else
		printf '%s\n' "$block" |
			grep -E 'Profile URL|Logged in as|Cluster:|Roles:|Logins:|Valid until' |
			sed -E 's/^[[:space:]]*>?[[:space:]]*/  /'
		if printf '%s\n' "$block" | grep -qiE 'Valid until:.*(EXPIRED|valid for -)'; then
			printf '  NOT READABLE: certificate expired for %s — ask the owner for a login tap\n' "$proxy"
			unreadable=$((unreadable + 1))
		fi
	fi

	# ---- ls: the nodes this cluster actually holds ----------------------
	printf -- '--- tsh ls --proxy=%s\n' "$proxy"
	ls_json="$(timeout "$bound" "$tsh_bin" ls --proxy="$proxy" --format=json </dev/null 2>&1)"
	ls_rc=$?
	nodes=""
	planes=""
	if [ "$ls_rc" -eq 0 ] && command -v jq >/dev/null 2>&1 &&
		printf '%s' "$ls_json" | jq -e . >/dev/null 2>&1; then
		nodes="$(printf '%s' "$ls_json" | jq -r '.[] | (.spec.hostname // .metadata.name)' | sort -u)"
		planes="$(printf '%s' "$ls_json" |
			jq -r '.[] | "\(.spec.hostname // .metadata.name) plane=\(.metadata.labels.plane // "-")"' |
			sort -u)"
	elif [ "$ls_rc" -eq 0 ]; then
		# No jq (or non-JSON output): fall back to the plain table.
		ls_text="$(timeout "$bound" "$tsh_bin" ls --proxy="$proxy" </dev/null 2>&1)"
		ls_rc=$?
		nodes="$(printf '%s\n' "$ls_text" |
			awk 'seen { if (NF) print $1 } /^-----/ { seen = 1 }' | sort -u)"
		planes="$nodes"
	fi

	if [ "$ls_rc" -ne 0 ]; then
		reason="tsh ls failed (rc=$ls_rc)"
		[ "$ls_rc" -eq 124 ] && reason="tsh ls timed out after ${bound}s"
		detail="$(printf '%s\n' "$ls_json" | grep -v '^[[:space:]]*$' | head -n 1)"
		[ -n "$detail" ] && reason="$reason: $detail"
		printf '  NOT READABLE: %s — ask the owner for a login tap\n' "$reason"
		unreadable=$((unreadable + 1))
		summary="${summary}${proxy}: NOT READABLE\n"
		continue
	fi

	count="$(printf '%s\n' "$nodes" | grep -c . || true)"
	printf '  node count: %s\n' "$count"
	if [ "$count" -gt 0 ]; then
		printf '%s\n' "$planes" | sed 's/^/  - /'
		summary="${summary}${proxy}: ${count} node(s) — $(printf '%s' "$nodes" | paste -sd, - | sed 's/,/, /g')\n"
	else
		printf '  (this cluster holds no nodes)\n'
		summary="${summary}${proxy}: 0 node(s)\n"
	fi
done

printf '\n=== summary\n'
printf '%b' "$summary"
printf '\n'
printf 'a node absent from every cluster above is unreachable via Teleport; absent from one cluster proves nothing\n'

[ "$unreadable" -eq 0 ] || exit 1
exit 0
