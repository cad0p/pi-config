{
  "lastChangelogVersion": "1.4.0",
  "defaultProvider": "anthropic",
  "defaultModel": "claude-opus-5-5",
  "defaultThinkingLevel": "high",
  "npmCommand": [
    "pnpm"
  ],
  "steeringMode": "all",
  "doubleEscapeAction": "tree",
  "treeFilterMode": "no-tools",
  "packages": [
    {
      "source": "npm:@cad0p/pi-heartbeat@next",
      "skills": [
        "-skills/pi-heartbeat/SKILL.md"
      ]
    },
    {
      "source": "npm:pi-shipit",
      "skills": [
        "-skills/review-fix-loop/SKILL.md",
        "-skills/submit-fork-pr/SKILL.md"
      ]
    },
    {
      "source": "npm:@cad0p/pi-napkin@next",
      "extensions": [
        "+extensions/distill/index.ts",
        "+extensions/napkin-context/index.ts"
      ],
      "skills": [
        "-skills/napkin/SKILL.md"
      ]
    },
    {
      "source": "npm:@cad0p/pi-pioneer-provider@next",
      "extensions": [
        "-index.ts"
      ]
    },
    "npm:@cad0p/pi-subagents-tintinweb@next",
    "npm:@cad0p/pi-fallback-provider@next",
    {
      "source": "npm:@cad0p/pi-steering@next",
      "extensions": [
        "+src/index.ts"
      ],
      "skills": [
        "+skills/steering-authoring/SKILL.md"
      ]
    },
    "npm:@cad0p/pi-timestamps@next",
    {
      "source": "npm:@cad0p/pi-provider-umans@next",
      "extensions": [
        "-web-search.ts",
        "-index.ts"
      ]
    },
    "npm:@cad0p/pi-bash-timeout@next",
    "npm:@cad0p/pi-tree-navigator@next",
    {
      "source": "npm:@getpipher/vision",
      "extensions": [
        "-extensions/paste.ts",
        "-extensions/vision.ts"
      ]
    },
    "npm:pi-context-view",
    {
      "source": "npm:mitsupi",
      "extensions": [
        "extensions/session-breakdown.ts"
      ],
      "skills": [],
      "prompts": [],
      "themes": []
    },
    {
      "source": "./patches/local-patches",
      "extensions": [
        "extensions/autopatch.ts"
      ]
    },
    "npm:@cad0p/pi-background-work@next"
  ],
  "theme": "light/dark",
  "externalEditor": "nvim",
  "enabledModels": [
    "anthropic/claude-opus-5-5:high",
    "opencode-go/deepseek-v4.1-flash:max",
    "opencode-go-2/deepseek-v4.1-flash:max",
    "opencode-go-3/deepseek-v4.1-flash:max",
    "opencode-go-4/deepseek-v4.1-flash:max",
    "opencode-go-5/deepseek-v4.1-flash:max"
  ],
  "defaultProjectTrust": "always",
  "compaction": {
    "enabled": false
  },
  "showCacheMissNotices": true,
  "tuiMode": "fullscreen",
  "hideThinkingBlock": false,
  "terminal": {
    "showTerminalProgress": false
  },
  "warnings": {
    "anthropicExtraUsage": false
  },
  "defaultTools": [
    "+codemode"
  ],
  "codemode": {
    "mode": "only",
    "inlineBudget": 4700
  },
  "cacheWarming": "idle"
}
