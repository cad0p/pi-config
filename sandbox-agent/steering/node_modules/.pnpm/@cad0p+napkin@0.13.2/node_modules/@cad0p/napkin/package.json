{
  "name": "@cad0p/napkin",
  "version": "0.13.2",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "description": "📜 Knowledge system for agents. Local-first, file-based, progressively disclosed.",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "napkin": "./bin/napkin.js"
  },
  "files": [
    "src",
    "bin",
    "skills"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "node --import tsx src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "biome format --write src/",
    "lint": "biome lint src/",
    "check": "biome check src/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cad0p/napkin.git"
  },
  "homepage": "https://github.com/cad0p/napkin#readme",
  "bugs": {
    "url": "https://github.com/cad0p/napkin/issues"
  },
  "keywords": [
    "obsidian",
    "cli",
    "markdown",
    "vault",
    "notes",
    "tasks",
    "tags",
    "search",
    "local-first"
  ],
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.6.0",
    "pkg-pr-new": "^0.0.75",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "gray-matter": "^4.0.3",
    "ignore": "^7.0.6",
    "jexl": "^2.3.0",
    "jiti": "^2.6.0",
    "js-yaml": "^4.1.0",
    "minisearch": "^7.2.0",
    "sql.js": "^1.14.0"
  },
  "optionalDependencies": {
    "glimpseui": "^0.3.7"
  }
}
