{
  "name": "@cad0p/unbash-walker",
  "version": "0.1.0-20260904.0",
  "private": false,
  "description": "Utility for walking unbash ASTs — extract commands, expand wrappers, resolve effective cwd.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cad0p/unbash-walker.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "pnpm build",
    "test": "node --test --experimental-strip-types 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/"
  },
  "dependencies": {
    "unbash": "^4.0.11"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "@biomejs/biome": "^2.3.14",
    "@types/node": "^20.19.39"
  },
  "publishConfig": {
    "access": "public"
  }
}
